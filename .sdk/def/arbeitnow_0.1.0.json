{
  "openapi": "3.0.3",
  "info": {
    "title": "Arbeitnow",
    "description": "Arbeitnow helps companies hire candidates with visa sponsorship / four day work week / remote opportunities.",
    "version": "1.0.0",
    "contact": {
      "name": "Arbeitnow API Documentation",
      "url": "https://documenter.getpostman.com/view/18545278/UVJbJdKh"
    }
  },
  "servers": [
    {
      "url": "https://www.arbeitnow.com/api",
      "description": "Production server"
    }
  ],
  "paths": {
    "/job-board-api": {
      "get": {
        "summary": "Get job listings",
        "description": "Retrieve job listings from Arbeitnow with optional filtering capabilities for visa sponsorship, remote work, and four day work week opportunities.",
        "operationId": "getJobListings",
        "tags": [
          "Jobs"
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Search term to filter jobs by title, company name, or description",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "description": "Filter jobs by location",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with job listings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "slug": {
                            "type": "string",
                            "description": "Unique identifier for the job posting"
                          },
                          "company_name": {
                            "type": "string",
                            "description": "Name of the hiring company"
                          },
                          "title": {
                            "type": "string",
                            "description": "Job title"
                          },
                          "description": {
                            "type": "string",
                            "description": "Detailed job description"
                          },
                          "remote": {
                            "type": "boolean",
                            "description": "Whether the job offers remote work"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri",
                            "description": "URL to the job posting"
                          },
                          "tags": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Tags associated with the job (e.g., technologies, skills)"
                          },
                          "job_types": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Type of employment (e.g., full-time, part-time, contract)"
                          },
                          "location": {
                            "type": "string",
                            "description": "Job location"
                          },
                          "created_at": {
                            "type": "integer",
                            "description": "Timestamp when the job was created"
                          }
                        }
                      }
                    },
                    "links": {
                      "type": "object",
                      "properties": {
                        "first": {
                          "type": "string",
                          "format": "uri",
                          "description": "Link to the first page"
                        },
                        "last": {
                          "type": "string",
                          "format": "uri",
                          "description": "Link to the last page"
                        },
                        "prev": {
                          "type": "string",
                          "format": "uri",
                          "nullable": true,
                          "description": "Link to the previous page"
                        },
                        "next": {
                          "type": "string",
                          "format": "uri",
                          "nullable": true,
                          "description": "Link to the next page"
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "current_page": {
                          "type": "integer",
                          "description": "Current page number"
                        },
                        "from": {
                          "type": "integer",
                          "description": "Starting item number on current page"
                        },
                        "last_page": {
                          "type": "integer",
                          "description": "Total number of pages"
                        },
                        "path": {
                          "type": "string",
                          "description": "Base path of the API endpoint"
                        },
                        "per_page": {
                          "type": "integer",
                          "description": "Number of items per page"
                        },
                        "to": {
                          "type": "integer",
                          "description": "Ending item number on current page"
                        },
                        "total": {
                          "type": "integer",
                          "description": "Total number of items"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Jobs",
      "description": "Job listing operations"
    }
  ]
}
